     """Write frames as XTC file."""
-    from ..core.xtc import XTCWriter, XTCMetadata
+    from ..core.xtc import XTCWriter, XTCMetadata, XTCChapter
     import time

     if not frames:
@@ -251,12 +251,40 @@ def write_xtc(output: str, frames: list[XTFrameAsset], cfg: dict[str, Any]) -> N
     direction_map = {'ltr': 0, 'rtl': 1, 'ttb': 2}
     reading_direction = direction_map.get(output_cfg.get('direction', 'ltr'), 0)

+    # Chapters (optional): [[chapters]] array-of-tables in the config, e.g.
+    #
+    #   [[chapters]]
+    #   name = "Chapter One"
+    #   start_page = 0
+    #   end_page = 5
+    #
+    # Entries missing a field, or with a non-int start_page/end_page, are
+    # skipped rather than raising -- a malformed chapters config must not
+    # block the whole conversion, matching this module's general stance on
+    # optional metadata (see the title/author handling above).
+    chapters: list[XTCChapter] = []
+    for entry in cfg.get('chapters', []) or []:
+        if not isinstance(entry, dict):
+            continue
+        name = entry.get('name')
+        start_page = entry.get('start_page')
+        end_page = entry.get('end_page')
+        if (
+            not isinstance(name, str)
+            or not isinstance(start_page, int) or isinstance(start_page, bool)
+            or not isinstance(end_page, int) or isinstance(end_page, bool)
+        ):
+            logger.warning(f"Skipping malformed chapter entry: {entry!r}")
+            continue
+        chapters.append(XTCChapter(name=name, start_page=start_page, end_page=end_page))
+
     # Create XTC writer and write frames
     writer = XTCWriter(
         width=width,
         height=height,
         reading_direction=reading_direction,
         metadata=metadata,
+        chapters=chapters or None,
         page_format=page_format
     )

